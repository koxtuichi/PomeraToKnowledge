    {
      "id": "日記:2026-02-26",
      "label": "2026年2月26日の日記",
      "type": "日記",
      "detail": "仕事への不安、体重の進捗、DM250の満足感、クレカ請求の整理、仕事の進捗と妻の体調について",
      "date": "2026-02-26",
